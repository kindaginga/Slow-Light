{
  "name": "slow-light",
  "productName": "Slow Light",
  "version": "0.1.3",
  "description": "Make a still deep-sky image move.",
  "author": "Orrerium Studios LLC",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "www": "node scripts/www.js",
    "android": "npm run www && npx cap sync android && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.slowlight.app",
    "productName": "Slow Light",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "app.html",
      "app.js",
      "index.html",
      "icon.svg",
      "build/icon.png",
      "assets/poster.jpg",
      "!assets/demo.mp4",
      "!release/**",
      "!www/**",
      "!android/**",
      "!ios/**",
      "!scripts/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.photography"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
